# Copy this file to .env.aiven and fill in real values.
# .env.aiven is git-ignored — never commit real secrets.
#
# These come from the Aiven console: your MySQL service -> Overview ->
# Connection details ("General" tab). SSL is required by Aiven, so you
# also need the downloaded CA certificate file's path on your machine.

AIVEN_DB_HOST=your-service-host.aivencloud.com
AIVEN_DB_PORT=your-service-port
AIVEN_DB_USER=avnadmin
AIVEN_DB_PASSWORD=
AIVEN_DB_NAME=defaultdb
AIVEN_SSL_CA_PATH=/full/path/to/downloaded/ca.pem
