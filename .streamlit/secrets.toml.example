# Template for Streamlit Community Cloud's Secrets manager — NOT read
# directly by the app. When deploying, paste the real values (with your
# real Aiven credentials) into the app's Settings -> Secrets box on
# share.streamlit.io. Local dev keeps using .env instead; this file only
# matters once the app is actually deployed.
#
# .streamlit/secrets.toml (the real file, if you ever create one locally)
# is already git-ignored — never commit real secrets.

ANTHROPIC_API_KEY = "your-anthropic-api-key-here"

# Aiven MySQL (trimmed subset) — deployed demo only, see Technical
# Design.md Section 1 and scripts/export_subset_to_aiven.sh
DB_HOST = "your-service-host.aivencloud.com"
DB_PORT = "26995"
DB_USER = "avnadmin"
DB_PASSWORD = "your-aiven-password"
DB_NAME = "defaultdb"

# Paste the full contents of the downloaded CA certificate file here
# (open ca.pem in a text editor and copy everything, including the
# BEGIN/END CERTIFICATE lines). app.py writes this to a temp file at
# startup and points DB_SSL_CA at it — see the comment block at the top
# of app.py for why.
DB_SSL_CA_CONTENT = """
-----BEGIN CERTIFICATE-----
paste the full certificate content here
-----END CERTIFICATE-----
"""
